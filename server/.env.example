DATABASE_URL=postgresql+psycopg2://postgres:password@db.example.supabase.co:5432/postgres
ADMIN_API_KEY=replace-with-a-long-admin-secret
PREDICTION_ALPHA=0.7
PREDICTION_BETA=0.3
PREDICTION_WINDOW_SIZE=20
PREDICTION_INTERVAL_MINUTES=60
PREDICTION_MIN_READINGS=20
SCHEDULER_ENABLED=true
PUSH_ENABLED=true
ANDROID_CHANNEL_ID=pond_alerts
ALERT_NOTIFY_COOLDOWN_MINUTES=30
OFFLINE_NOTIFY_AFTER_MINUTES=5
# For hosting platforms, paste the service-account JSON as one-line JSON:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# For local development instead, set the path to the downloaded JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
# CORS_ORIGINS=["http://localhost:8080"]# Comma-separated origins can be added to the application settings when deployment needs them.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
